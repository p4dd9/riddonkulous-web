# REDDICORE_API_BASE_URL=https://reddicore.hammertime.studio/api/v1/riddonk/web
REDDICORE_API_BASE_URL=https://reddicore.hammertime.studio/api/v1/riddonk/web
REDDICORE_API_KEY=
NODE_ENV=development
TZ='Europe/Vienna'

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

PUBLIC_SESSION_SECRET=
PUBLIC_PASSWORD=

GOOGLE_OAUTH_REDIRECT_URI=

# Basics
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Discord Bot Configuration
# Bot token from Discord Developer Portal (https://discord.com/developers/applications)
# Get your bot token from: https://discord.com/developers/applications > Your Application > Bot > Token
DISCORD_BOT_TOKEN=

# Discord Application/Client ID (optional, useful for OAuth/scopes)
# Found in Discord Developer Portal > General Information
DISCORD_CLIENT_ID=

# Channel name pattern to find channels across all servers
# The bot will search for channels matching this name in all servers it's connected to
# Examples: "daily-riddles", "announcements", "riddles", "general"
# Leave empty to send to all channels the bot can access (not recommended)
DISCORD_CHANNEL_NAME_PATTERN=riddles

# Optional: Specific server (Guild) IDs and Channel IDs for targeted posting
# Format: guildId:channelId,guildId:channelId
# Example: 123456789:987654321,111222333:444555666
# If specified, messages will ONLY be sent to these channels (overrides DISCORD_CHANNEL_NAME_PATTERN)
# To get IDs: Enable Developer Mode in Discord > Right-click server/channel > Copy ID
DISCORD_TARGET_CHANNELS=

# Discord Bot Scopes Required:
# - bot (for bot functionality)
# 
# Discord Bot Scopes Required:
# - bot (for bot functionality)
# 
# Discord Bot Permissions Required:
# - View Channels (1024)
# - Send Messages (2048)
# - Embed Links (16384)
# 
# To invite bot to server, use this URL format:
# https://discord.com/api/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=19456&scope=bot
# (Replace YOUR_CLIENT_ID with your actual client ID)
# Permission value 19456 = View Channels + Send Messages + Embed Links
# For more permissions, use: https://discordapi.com/permissions.html

# Note: For !daily command to work, enable "MESSAGE CONTENT INTENT" in Discord Developer Portal:
# Discord Developer Portal > Your Application > Bot > Privileged Gateway Intents > MESSAGE CONTENT INTENT
